; Shell project: only used to make Godot write the iOS Xcode project.
; The game comes from its own pack, which replaces this project's pack in
; the Xcode project before it is built.
config_version=5

[application]

config/name="@NAME@"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("@FEATURE@", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
